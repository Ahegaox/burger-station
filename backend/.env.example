# Valores de ejemplo para desarrollo en local. Copia este archivo como ".env".

# Con Docker Compose esta URL se sustituye por la del contenedor de Postgres.
DATABASE_URL=postgresql+psycopg://burger:burger123@localhost:5432/burger_station

# Clave para firmar los tokens. En producción genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=clave-solo-para-desarrollo-en-local-cambiala-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opcional: sin estos dos valores la app funciona, pero no envía emails.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Opcional: orígenes permitidos por CORS, separados por comas.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
